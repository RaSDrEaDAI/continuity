# Continuity — environment
# Copy to .env and adjust. Never commit .env.

# ComfyUI endpoint speaking Comfy API v2.
#   local instance:      http://127.0.0.1:8188
#   comfy-api-proxy:     http://127.0.0.1:8190   (proxy in front of your ComfyUI)
CONTINUITY_COMFY_URL=http://127.0.0.1:8190

# API key if your endpoint requires one (comfy-api-proxy / managed Comfy API).
# Leave empty for a plain local ComfyUI.
CONTINUITY_COMFY_API_KEY=

# T5 tokenizer path for the token auditor (ships with ComfyUI's text_encoders).
CONTINUITY_T5_TOKENIZER=C:/Users/Owner/ComfyUI-Installs/ComfyUI/ComfyUI/comfy/text_encoders/t5_tokenizer

# Vision instrument backend for Gate A (endpoint or model id).
CONTINUITY_VISION_URL=

# Working dir for renders, QC artifacts, and the master cut.
CONTINUITY_WORKDIR=./work

# Cloudinary delivery (optional — leave empty to keep artifacts local).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
